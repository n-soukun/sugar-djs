{
	"name": "sugar-djs",
	"version": "1.0.5",
	"description": "Library for writing discord.js in TypeScript for more fun!",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"prepare": "npm run build",
		"test": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
		"test:types": "tsc --project tsconfig.test.json --noEmit",
		"test:compat": "npm run test && npm run test:types"
	},
	"author": "soukun",
	"license": "MIT",
	"homepage": "https://github.com/n-soukun/sugar-djs#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n-soukun/sugar-djs.git"
	},
	"peerDependencies": {
		"discord.js": ">=14.25.0 <14.28.0"
	},
	"dependencies": {
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"discord.js": "14.27.0",
		"jest": "^30.0.0",
		"typescript": "^5.9.3"
	}
}
